@page
@model gift_of_thegivers.Pages.Donate.CertificateModel
@{
    ViewData["Title"] = "Donation Certificate";
}

<div class="page-header text-center">
    <div class="container">
        <h1 class="h2 fw-bold mb-2">Donation Certificate</h1>
        <p class="mb-0 opacity-75">Generated by Azure Function</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card p-4 p-md-5">

                @if (TempData["Certificate"] != null)
                {
                    <pre style="white-space: pre-wrap; font-family: Consolas, monospace; background-color: #f8f9fa; padding: 20px; border-radius: 8px; border: 1px solid #dee2e6;">
    @TempData["Certificate"]
                        </pre>
                }
                else
                {
                    <p class="text-muted">No certificate data available.</p>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Donor</dt>
                        <dd class="col-sm-8">@(TempData["DonorName"] ?? "Guest")</dd>

                        <dt class="col-sm-4">Amount</dt>
                        <dd class="col-sm-8">@TempData["Amount"] @TempData["Currency"]</dd>

                        <dt class="col-sm-4">Type</dt>
                        <dd class="col-sm-8">@TempData["DonationType"]</dd>

                        <dt class="col-sm-4">Date</dt>
                        <dd class="col-sm-8">@DateTime.Now.ToString("dd MMMM yyyy")</dd>
                    </dl>
                }

                <div class="alert alert-warning small mt-4 mb-4">
                    <strong>Note:</strong> This is not an official SARS tax certificate.
                    A real certificate would be issued after the donation is confirmed.
                </div>

                <a asp-page="/Donate/Index" class="btn btn-outline-primary">
                    Make another donation
                </a>
            </div>
        </div>
    </div>
</div>