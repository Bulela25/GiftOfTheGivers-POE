@page
@model gift_of_thegivers.Pages.Donate.IndexModel
@{
    ViewData["Title"] = "Donate";
}

<div class="page-header text-center">
    <div class="container">
        <h1 class="h2 fw-bold mb-2">Support Our Work</h1>
        <p class="mb-0 opacity-75">Every contribution helps us respond faster</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card p-4 p-md-5">
                <form method="post">
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Type of donation</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="DonationType" value="OneTime" id="oneTime" checked>
                            <label class="form-check-label" for="oneTime">One-time donation</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="DonationType" value="Recurring" id="recurring">
                            <label class="form-check-label" for="recurring">Monthly recurring</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label fw-semibold">Amount</label>
                        <input asp-for="Amount" type="number" step="0.01" min="1" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Currency" class="form-label fw-semibold">Currency</label>
                        <select asp-for="Currency" class="form-select">
                            <option value="ZAR">South African Rand (ZAR)</option>
                            <option value="USD">US Dollar (USD)</option>
                            <option value="EUR">Euro (EUR)</option>
                        </select>
                    </div>

                    <div class="mb-4 form-check">
                        <input class="form-check-input" asp-for="IsAnonymous" type="checkbox" id="anonymous">
                        <label class="form-check-label" for="anonymous">
                            Donate as anonymous guest
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Continue to Certificate
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
