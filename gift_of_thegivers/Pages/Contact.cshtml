@page
@model gift_of_thegivers.Pages.ContactModel
@{
    ViewData["Title"] = "Contact";
}

<div class="page-header text-center">
    <div class="container">
        <h1 class="h2 fw-bold mb-2">Contact Us</h1>
        <p class="mb-0 opacity-75">We would love to hear from you</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card p-4 p-md-5">
                <h2 class="h5 mb-4">Get in Touch</h2>

                <p class="mb-3">
                    <i class="bi bi-envelope me-2 text-primary"></i>
                    <strong>Email:</strong><br>
                    <a href="mailto:info@giftofthegivers.org">info@giftofthegivers.org</a>
                </p>

                <p class="mb-3">
                    <i class="bi bi-telephone me-2 text-primary"></i>
                    <strong>Phone:</strong><br>
                    +27 31 000 0000
                </p>

                <p class="mb-0">
                    <i class="bi bi-geo-alt me-2 text-primary"></i>
                    <strong>Address:</strong><br>
                    1 Relief Way<br>
                    Durban, South Africa
                </p>
            </div>
        </div>
    </div>
</div>
