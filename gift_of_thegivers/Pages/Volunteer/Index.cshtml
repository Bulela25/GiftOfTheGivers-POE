@page
@model gift_of_thegivers.Pages.Volunteer.IndexModel
@{
    ViewData["Title"] = "Volunteer";
}

<div class="page-header text-center">
    <div class="container">
        <h1 class="h2 fw-bold mb-2">Volunteer With Us</h1>
        <p class="mb-0 opacity-75">Offer your time and skills</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card p-4 p-md-5">

                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-success mb-4">
                        @TempData["Message"]
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                        <input asp-for="FullName" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Skills" class="form-label fw-semibold">Skills / Experience</label>
                        <textarea asp-for="Skills" class="form-control" rows="4" required></textarea>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Availability" class="form-label fw-semibold">Availability</label>
                        <input asp-for="Availability" class="form-control"
                               placeholder="e.g. Weekends, 2 weeks notice, etc." required>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Submit Interest
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>