@page
@model gift_of_thegivers.Pages.Employee.DashboardModel
@{
}
<div class="page-header text-center">
    <div class="container">
        <h1 class="h2 fw-bold mb-2">Staff Dashboard</h1>
        <p class="mb-0 opacity-75">Welcome, @User.Identity?.Name</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card p-4 h-100">
                <h3 class="h5 mb-3">
                    <i class="bi bi-megaphone me-2 text-warning"></i>
                    Project Updates
                </h3>
                <p class="text-muted small mb-4">
                    Post and view updates about ongoing relief projects.
                </p>
                <a asp-page="/Employee/ProjectUpdates" class="btn btn-primary">
                    Manage Updates
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-4 h-100">
                <h3 class="h5 mb-3">
                    <i class="bi bi-people me-2 text-warning"></i>
                    Volunteer Sign-ups
                </h3>
                <p class="text-muted small mb-4">
                    View people who have registered interest in volunteering.
                </p>
                <a asp-page="/Employee/Volunteers" class="btn btn-outline-primary">
                    View Volunteers
                </a>
            </div>
        </div>
    </div>
</div>
