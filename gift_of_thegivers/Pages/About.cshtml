@page
@model gift_of_thegivers.Pages.AboutModel
@{
    ViewData["Title"] = "About";
}

<div class="page-header text-center">
    <div class="container">
        <h1 class="h2 fw-bold mb-2">About Gift of the Givers</h1>
        <p class="mb-0 opacity-75">Who we are and what drives us</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card p-4 p-md-5">
                <h2 class="h4 mb-3">Our Mission</h2>
                <p>
                    Gift of the Givers is a disaster-response organisation that focuses on practical,
                    on-the-ground help. We work in flood zones, drought-affected areas and conflict
                    regions, always aiming to get supplies and support to people as quickly as possible.
                </p>

                <h2 class="h4 mt-4 mb-3">What We Do</h2>
                <ul class="mb-4">
                    <li>Emergency food and water distribution</li>
                    <li>Medical clinics and essential medicines</li>
                    <li>Temporary shelter and non-food items</li>
                    <li>Search-and-rescue support when needed</li>
                    <li>Longer-term recovery and rebuilding projects</li>
                </ul>

                <p class="mb-0">
                    We rely on public donations and skilled volunteers to keep our teams ready to respond.
                </p>
            </div>
        </div>
    </div>
</div>

